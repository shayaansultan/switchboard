{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "Run and monitor multiple Claude and Codex accounts side by side on macOS",
  "license": "MIT",
  "author": "Shayaan Sultan",
  "main": "out/main.js",
  "scripts": {
    "oc": "bun src/opencode/cli.ts",
    "cli": "bun src/cli.ts",
    "start": "bun run build && electron .",
    "icons": "electron build/render-icons.js",
    "dist": "bun run build && electron-builder --mac --dir",
    "install-app": "bun run dist && APP=$(ls -d dist/mac*/Switchboard.app | head -1) && rm -rf /Applications/Switchboard.app && ditto \"$APP\" /Applications/Switchboard.app && codesign --force --deep --sign - /Applications/Switchboard.app && rm -rf dist && open /Applications/Switchboard.app",
    "test": "oxlint && bun run typecheck && bun test",
    "test:claude-pty": "bun run build && node --test test/claude-pty.node.cjs",
    "test:awake-ui": "bun run build && bun demo/test-awake.mjs",
    "test:buckets-ui": "bun run build && bun demo/test-buckets.mjs",
    "test:model-labels": "bun run build && node demo/test-model-labels.mjs",
    "test:claude-models": "bun run build && node demo/test-claude-models.mjs",
    "demo": "bun run build && bun demo/capture.mjs",
    "fmt": "oxfmt",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit && tsc -p src/renderer",
    "build": "rm -rf out && tsc && bun build src/renderer/main.tsx --outdir out/renderer --target browser && cp src/renderer/index.html src/renderer/style.css out/renderer/ && cp -R src/renderer/fonts out/renderer/fonts"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "playwright": "^1.49.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "dev.shayaan.switchboard",
    "productName": "Switchboard",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "files": [
      "out/**/*",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/icon-1024.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "trustedDependencies": [
    "electron",
    "electron-builder",
    "@electron/rebuild"
  ]
}
