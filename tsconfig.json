{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out",
    "target": "ES2022",
    "module": "node16",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "moduleDetection": "legacy"
  },
  "include": [
    "src/**/*.ts"
  ]
}
